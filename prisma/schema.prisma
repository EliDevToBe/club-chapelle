generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum competition_category {
  indoor
  outdoor
}

enum competition_type {
  olympic
  beursault
  field
  nature
  d3
}

enum registration_status {
  to_register
  pending
  waiting_list
  registered
  cancelled
}

enum payment_status {
  to_pay
  pending_reimbursement
  paid
  cancelled
}

enum payer {
  archer
  club
}

enum distance {
  m18
  m50
  m60
  m70
  beginner
  other
}

enum target {
  trispot
  spot40
}

enum weapon {
  recurve
  barebow
  longbow
  compound
}

enum token_type {
  invitation
  forgot_password
  reset_password
  change_email
}

enum role {
  member
  manager
  admin
  developer
}

enum session {
  session_1
  session_2
  session_3
  session_4
  session_5
  session_6
}

model website_config {
  key        String   @id
  settings   Json
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  @@unique([key])
  @@index([key])
}

model archer {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_user_id   String?         @db.Uuid
  public_name    String
  created_at     DateTime        @default(now()) @db.Timestamptz
  offboarded_at  DateTime?       @db.Timestamptz
  auth_user      auth_user?      @relation(fields: [auth_user_id], references: [id])
  participations participation[]

  @@unique([public_name])
  @@index([auth_user_id])
}

model auth_user {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String
  password      String?
  created_at    DateTime         @default(now()) @db.Timestamptz
  authenticated Boolean          @default(false)
  archers       archer[]
  tokens        token[]
  roles         auth_user_role[]

  @@unique([email])
}

model auth_user_role {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_user_id String    @db.Uuid
  role         role      @default(member)
  auth_user    auth_user @relation(fields: [auth_user_id], references: [id], onDelete: Cascade)

  @@unique([auth_user_id, role])
}

model competition {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  file_id         String?              @db.Uuid
  name            String
  start_date      DateTime             @db.Date
  end_date        DateTime             @db.Date
  place           String?
  price           Decimal              @db.Decimal(6, 2)
  category        competition_category
  type            competition_type
  is_championship Boolean              @default(false)
  season_year     Int                  @db.SmallInt
  created_at      DateTime             @default(now()) @db.Timestamptz
  file            file?                @relation(fields: [file_id], references: [id])
  participations  participation[]

  @@index([name, start_date, end_date])
}

model participation {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  archer_id           String              @db.Uuid
  competition_id      String              @db.Uuid
  registration_status registration_status @default(to_register)
  payment_status      payment_status      @default(to_pay)
  payer               payer               @default(archer)
  distance            distance
  target              target?
  weapon              weapon?
  created_at          DateTime            @default(now()) @db.Timestamptz
  updated_at          DateTime            @default(now()) @db.Timestamptz
  archer              archer              @relation(fields: [archer_id], references: [id])
  competition         competition         @relation(fields: [competition_id], references: [id])
  session             session?
}

model file {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  mimetype             String
  url                  String?
  bucket_id            String?
  internal_bucket_name String?
  created_at           DateTime      @default(now()) @db.Timestamptz
  competitions         competition[]
}

model token {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_user_id String     @db.Uuid
  token_value  String
  type         token_type
  created_at   DateTime   @default(now()) @db.Timestamptz
  expires_at   DateTime   @db.Timestamptz
  used_at      DateTime?  @db.Timestamptz
  revoked_at   DateTime?  @db.Timestamptz
  auth_user    auth_user  @relation(fields: [auth_user_id], references: [id], onDelete: Cascade)
}
