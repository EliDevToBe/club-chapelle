# Use at runtime with the Prisma driver adapter.
DATABASE_URL=xxx
# Used by Prisma Migrate and CLI from prisma.config.ts when set; otherwise falls back to DATABASE_URL.
DIRECT_URL=xxx

# Local password
SEED_DEV_PASSWORD=admin

# Auth Tokens
AUTH_JWT_ACCESS_SECRET=xxx
AUTH_JWT_REFRESH_SECRET=xxx

# Secret pepper for password hashing
AUTH_PASSWORD_SECRET=xxx

# Env
NODE_ENV=development

# Mailtrap — transactional email (https://mailtrap.io/api-tokens)
# Use a sandbox token + MAILTRAP_USE_SANDBOX=true locally; use a production sending token in prod.
MAILTRAP_API_KEY=xxx
MAILTRAP_USE_SANDBOX=true
# Required when MAILTRAP_USE_SANDBOX=true (Email Testing inbox id)
MAILTRAP_INBOX_ID=xxx
# From address: must match a verified sending domain in production
MAILTRAP_FROM_EMAIL=noreply@your-verified-domain.example
MAILTRAP_FROM_NAME="Les Archers de la Chapelle"
# Inbox that receives contact form submissions (defaults to club Gmail if unset)
CONTACT_FORM_TO_EMAIL=xxx
# Public origin for password recovery links (no trailing slash). Used in forgot-password e-mails.
PASSWORD_RESET_ORIGIN=http://localhost:3000

# SIRV CDN API
SIRV_API_CLIENT_ID=xxx
SIRV_API_CLIENT_SECRET=xxx
SIRV_CDN_DOMAIN=xxx
SIRV_DIRECTORY=xxx


## Minimal changes, test for actions