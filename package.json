{
  "name": "club-ai",
  "type": "module",
  "private": true,
  "dependencies": {
    "@nuxt/ui": "^4.6.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@sirv/rest-api-js": "^1.0.1",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.1",
    "jsonwebtoken": "^9.0.3",
    "mailtrap": "^4.5.1",
    "nuxt": "^4.4.2",
    "pg": "^8.20.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@nuxt/test-utils": "^3.23.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "cspell": "^10.0.0",
    "happy-dom": "^20.8.9",
    "prisma": "^7.7.0",
    "tsx": "^4.21.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.6"
  },
  "overrides": {
    "glob": "^13.0.6"
  },

  "scripts": {
    "build": "npx prisma generate && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "check": "biome check",
    "check:fix": "biome check --fix",
    "check:ts": "nuxt typecheck",
    "check:schema": "npx prisma validate && npx prisma format --check",
    "fix:schema": "npx prisma format",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:restart": "npm run db:stop && npm run db:start",
    "db:reset": "docker compose down -v --rmi all --remove-orphans",
    "db:fullcycle": "npm run db:reset && npm run db:start && npx prisma migrate dev && npm run db:generate && npm run db:seed",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "migration:new": "npx prisma migrate dev",
    "migration:reset": "npx prisma migrate reset",
    "db:seed": "tsx --tsconfig tsconfig.seed.json prisma/seed/main.ts"
  }
}
